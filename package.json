{
  "name": "@joezhoujinjing/zzapi",
  "version": "0.2.0",
  "description": "中资（cneptp）寻源询价 OpenAPI 命令行客户端",
  "type": "module",
  "bin": {
    "zzapi": "dist/index.js"
  },
  "files": [
    "dist",
    "registry",
    "data",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.5.4"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cneptp",
    "中资",
    "寻源",
    "询价",
    "采购",
    "大宗商品",
    "价格",
    "openapi",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joezhoujinjing/zzapi.git"
  },
  "bugs": {
    "url": "https://github.com/joezhoujinjing/zzapi/issues"
  }
}
